# Copy to .env.local for local development (do NOT commit real keys).

# Default llm/image route (can point to Gemini direct or Compass gateway)
GEMINI_API_KEY=YOUR_GEMINI_KEY
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional: pin video generation (Veo) to direct Gemini even when GEMINI_BASE_URL uses Compass.
# If omitted, video falls back to GEMINI_API_KEY + GEMINI_BASE_URL.
# GEMINI_VIDEO_API_KEY=YOUR_GEMINI_KEY_FOR_VIDEO
# GEMINI_VIDEO_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional image dual-channel (Gemini primary + Compass fallback)
# VISION_IMAGE_DUAL_CHANNEL=1
# GEMINI_IMAGE_GEMINI_API_KEY=YOUR_GEMINI_KEY_FOR_IMAGE
# GEMINI_IMAGE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_IMAGE_COMPASS_API_KEY=YOUR_COMPASS_KEY_FOR_IMAGE
# GEMINI_IMAGE_COMPASS_BASE_URL=https://compass.llm.shopee.io/compass-api/v1

# Optional Compass helper vars (used by scripts/check_compass.py and dev-homework-compass.sh)
# COMPASS_API_KEY=YOUR_COMPASS_KEY
# COMPASS_GATEWAY_URL=https://compass.llm.shopee.io/compass-api/v1

# Optional extras (not used by homework runtime):
# OPENAI_API_KEY=YOUR_OPENAI_KEY
# OPENAI_BASE_URL=https://api.openai.com
# DEEPSEEK_API_KEY=YOUR_DEEPSEEK_KEY
# DEEPSEEK_BASE_URL=https://api.deepseek.com
