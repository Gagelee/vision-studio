# Copy to .env.local for local development (do NOT commit real keys).

# Primary (recommended inside Shopee network): Gemini via Compass gateway
COMPASS_API_KEY=YOUR_COMPASS_API_KEY
COMPASS_GATEWAY_URL=https://compass.llm.shopee.io/compass-api/v1

# Fallback: direct Gemini (optional)
GEMINI_API_KEY=YOUR_GEMINI_KEY
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Fallbacks (optional)
OPENAI_API_KEY=YOUR_OPENAI_KEY
OPENAI_BASE_URL=https://api.openai.com

DEEPSEEK_API_KEY=YOUR_DEEPSEEK_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
